<div id="<%= dom_id lead %>">
  <div>
    <strong>Name:</strong>
    <%= lead.name %>
  </div>

  <div>
    <strong>Company:</strong>
    <%= lead.company %>
  </div>

  <div>
    <strong>Email:</strong>
