<div id="<%= dom_id goal %>">
  <div>
    <strong>Title:</strong>
    <%= goal.title %>
  </div>

  <div>
    <strong>Target:</strong>
    <%= goal.target %>
  </div>

  <div>
    <strong>Achieved:</strong>
    <%= goal.achieved %>
  </div>

  <div>
    <strong>Progress:</strong>
    <%= goal.progress_percent %>%
  </div>

  <div>
    <strong>Due on:</strong>
    <%= goal.due_on %>
  </div>
</div>